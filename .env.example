# Application Configuration
APP_NAME="AI TAM SAM SOM Market Analyzer"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated list of allowed origins or *)
CORS_ALLOW_ORIGINS=*

# Ollama LLM Configuration (Local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120.0

# Source Fetching & Safety Configuration
SOURCE_FETCH_TIMEOUT_SECONDS=15.0
SOURCE_FETCH_MAX_BYTES=5242880

# Search Discovery Provider Configuration
# Supported: "mock" (zero network requests, local fixtures), "live" (Tavily / SearXNG / custom)
SEARCH_PROVIDER=live
SEARCH_API_URL=https://api.tavily.com/search
TAVILY_API_KEY=your_tavily_api_key_here
SEARCH_API_KEY=your_search_api_key_here
SEARCH_TIMEOUT_SECONDS=15.0

# Persistence Configuration
DATABASE_PATH=data/market_analyses.db
